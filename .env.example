# ---- Instagram ----
# Bu iki degeri doldurman gerekiyor.
# Token'i aldiktan sonra IG_USER_ID'yi otomatik bulmak icin:
#   python scripts/setup_instagram.py EAAG...
IG_ACCESS_TOKEN=
IG_USER_ID=

# Hangi yol kullanilacak. BOS BIRAK: setup_instagram.py token'a bakip
# kendisi dolduruyor.
#   https://graph.instagram.com  -> Instagram Login (Facebook sayfasi gerekmez)
#   https://graph.facebook.com   -> Facebook Login  (Facebook sayfasi sart)
GRAPH_BASE=

# ---- Gorsel barindirma ----
# Gorsellerin servis edildigi public kok URL (sonunda / olmadan).
# GitHub Actions bunu kendisi ayarlar; sadece yerelden paylasacaksan doldur.
# Ornek: https://raw.githubusercontent.com/kullanici/koudehava/main/output
IMAGE_BASE_URL=

# ---- Opsiyonel ----
# Token suresini/izinlerini sorgulayabilmek icin (App settings > Basic):
IG_APP_ID=
IG_APP_SECRET=

GRAPH_VERSION=v26.0
